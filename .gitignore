# Obsidian per-device UI state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.trash/
.DS_Store
Thumbs.db

# Graph page tooling (.bedrock/graph): watcher state and any temporary build output
.bedrock/graph/watch.log*
.bedrock/graph/watch.pid
.bedrock/graph/node_modules/
.bedrock/graph/*.tmp*

# Capture and recall (.bedrock/recall): derived recall index, sync cache and lock, hook log, import provenance copies
.bedrock/recall-index.json
.bedrock/recall-cache.json
.bedrock/recall/hook.log*
.bedrock/recall/index-slow.json
.bedrock/sync/
.bedrock/import/
# hidden temporary files of atomic writes (".<name>.tmp-<pid>"), anywhere in the vault
.*.tmp-*

# Obsidian blank stubs created by accidental "new canvas/base" clicks
Untitled*.canvas
Untitled*.base
# Private capture patterns (private values: stay local, never committed; see secrets.ts redactor)
.bedrock/recall/private-patterns.json
